{
  "dataset": "economic_projections",
  "publication_id": "51135",
  "title": "Economic Projections",
  "source_url": "https://www.cbo.gov/publication/51135",
  "description": "CBO's 10-year economic projections of output, prices, labor market, interest rates, income, and GDP components. Overlaps significantly with historical_economic (55022); adds derived rate/share variables and longer projection horizon.",
  "frequency": "quarterly",
  "date_format": "YYYYqN (e.g., 2023q1, 2036q4)",
  "canonical_columns": ["date", "variable", "value"],
  "notes": {
    "overlap_with_55022": "78 of 84 historical_economic level variables have identical values on overlapping dates. This dataset adds ~60 derived rate/share variables (_pct_change, _share_of_gdp suffixes).",
    "census_bls_split": "Starting 2026-02, population and labor force variables are split into Census-based and BLS-based variants. The _census suffix indicates Census basis; the unsuffixed variant uses BLS basis."
  },
